# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (use .env for production with real credentials)
DATABASE_URL=postgresql://${POSTGRES_USER:-osanvault}:${POSTGRES_PASSWORD}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-osanvault_db}

# Redis (use .env for production with real password)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST:-localhost}:${REDIS_PORT:-6379}

# Security
JWT_SECRET=${JWT_SECRET}
CORS_ORIGIN=${CORS_ORIGIN:-http://localhost:5173}

# Queue Authentication
QUEUE_SECRET=${QUEUE_SECRET}
