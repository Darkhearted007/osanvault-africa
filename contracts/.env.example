# ─── OsanVault Contracts — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Deployer wallet private key (without 0x prefix)
# Get test MATIC at: https://faucet.polygon.technology/
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Polygon Amoy RPC (default works, or use Alchemy/Infura for reliability)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygonscan API key for contract verification
# Get one free at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
