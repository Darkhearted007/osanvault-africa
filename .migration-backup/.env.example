# Database Configuration
# Vercel Postgres auto-populates these when you create a database:
# POSTGRES_URL="postgres://..."
# POSTGRES_PRISMA_URL="postgres://..."
# POSTGRES_URL_NON_POOLING="postgres://..."
# POSTGRES_USER="..."
# POSTGRES_HOST="..."
# POSTGRES_PASSWORD="..."
# POSTGRES_DATABASE="..."

# Your app uses this variable:
DATABASE_URL="${POSTGRES_PRISMA_URL}"

# Session Security
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"

# Blockchain Configuration
# Polygon Amoy Testnet RPC
# Get from: https://dashboard.alchemy.com/ or https://www.infura.io/
POLYGON_RPC_URL="https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY"

# Contract Deployment (Optional - only if deploying contracts from Vercel)
# WARNING: Use testnet keys only, never production keys
PRIVATE_KEY="your-testnet-deployer-private-key"
POLYGONSCAN_API_KEY="your-polygonscan-api-key"

# GitHub Integration (Optional - for GitHub API sync)
# Generate at: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
GITHUB_PAT="github_pat_..."

# Node Environment
NODE_ENV="production"

# Port (automatically set by Vercel, only needed for local development)
# PORT=3000
