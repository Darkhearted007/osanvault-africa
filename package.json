{
  "name": "@osanvault/root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev:api": "pnpm --filter @osanvault/api dev",
    "dev:web": "pnpm --filter web dev",
    "build:api": "pnpm --filter @osanvault/api build",
    "build:web": "pnpm --filter web build"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^14.0.0",
      "file-type": ">=21.3.2"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
