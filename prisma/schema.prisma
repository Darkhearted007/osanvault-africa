generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  wallet    String   @unique
  createdAt DateTime @default(now())

  ledger    LedgerEntry[]
}

model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  type      String   // CREDIT | DEBIT
  token     String   // OSANV
  amount    Float
  reason    String

  createdAt DateTime @default(now())
}
